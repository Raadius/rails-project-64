.container.mb-2
    .d-flex.flex-wrap.align-items-center.py-2.border-bottom
        .navbar.navbar-expand-md.navbar-light.me-auto
            = link_to root_path, class: 'navbar-brand' do
                = image_tag 'Hexlet Logo.jpg', alt: 'Home', width: '30'
        ul.nav.nav-pills
            - if user_signed_in?
                li.nav-item.me-2
                    p.nav-link.disabled = current_user.email
                li.nav-item.me-2
                    = link_to t('navbar.new_post'), '#', class: 'nav-link link-dark'
                li.nav-item.me-2
                    = link_to t('navbar.logout'), destroy_user_session_path,
                      data: { turbo_method: :delete }, class: 'nav-link link-dark'
            - else
                li.nav-item.me-2
                    = link_to t('navbar.sign_in'), new_user_session_path, class: 'nav-link link-dark'
                li.nav-item.me-2
                    = link_to t('navbar.sign_up'), new_user_registration_path, class: 'nav-link link-dark'
