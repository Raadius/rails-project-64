nav.navbar.navbar-expand-lg.navbar-light.bg-light.border-bottom
  .container
    = link_to 'Home', root_path, class: 'navbar-brand'

    .button.navbar-toggler data-bs-toggle='collapse' data-bs-target='#navbarNav'
      span.navbar-toggler-icon

    .collapse.navbar-collapse id='navbarNav'
      .ms-auto
        - if user_signed_in?
          d.flex.align-items-center.gap-3
            span.text-mutes = current_user.email
            = link_to t('navbar.new_post'), '#', class: 'text-decoration-none'
            = link_to t('navbar.logout'), destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: 'text-decoration-none'
        - else
          = link_to t('navbar.sign_in'), new_user_session_path, class: 'text-decoration-none'
          = link_to t('navbar.sign_up'), new_user_registration_path, class: 'text-decoration-none'